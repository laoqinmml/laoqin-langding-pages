---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  surface?: boolean;
}

const { id, eyebrow, title, surface = false } = Astro.props;
---

<section id={id} class:list={["section", surface && "section--surface"]}>
  <div class="container">
    {
      title && (
        <header class="section__head" data-reveal>
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h2>{title}</h2>
        </header>
      )
    }
    <slot />
  </div>
</section>
